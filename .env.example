# ===========================================
# Silent Bottleneck Detector - Environment Variables
# ===========================================

# watsonx.ai Configuration
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Cloudant Database
CLOUDANT_URL=your_cloudant_url_here
CLOUDANT_API_KEY=your_cloudant_api_key_here
CLOUDANT_DB_NAME=bottleneck_detector

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your_secret_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Mock Mode (set to 'true' to use mock watsonx responses)
USE_MOCK_AI=true
